<Window x:Class="ListaryOpen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ListaryOpen.App.Converters"
        Title="ListaryOpen"
        AutomationProperties.AutomationId="SettingsWindow"
        Icon="{StaticResource ListaryOpenIcon}"
        Height="650" Width="900" MinHeight="560" MinWidth="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown"
        StateChanged="MainWindow_StateChanged"
        SourceInitialized="MainWindow_SourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:SettingsOptionDisplayConverter x:Key="SettingsOptionDisplayConverter" />
        <Style x:Key="SettingsTabStyle" TargetType="TabItem">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="SelectionRail"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="Collapsed" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Grid.Column="2"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.WindowTitle}">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsRowTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SettingsPageScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="SettingsPageStackStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="32,28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SettingsCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Anti-aliased chrome: WPF CornerRadius (not SetWindowRgn) so Win10 corners stay smooth. -->
    <Border x:Name="WindowChromeBorder"
            Margin="10"
            Background="{DynamicResource Brush.AppBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="False"
            UseLayoutRounding="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.22"
                              Color="#50000000"
                              RenderingBias="Quality" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="SettingsTitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="SettingsTitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource ListaryOpenIcon}"
                               Width="16"
                               Height="16"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="SettingsWindowTitle"
                                   Text="ListaryOpen Options"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton"
                                Content="&#xE921;"
                                Style="{StaticResource SettingsCaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"
                                AutomationProperties.AutomationId="SettingsMinimizeButton" />
                        <Button x:Name="MaximizeButton"
                                Content="&#xE922;"
                                Style="{StaticResource SettingsCaptionButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize"
                                AutomationProperties.AutomationId="SettingsMaximizeButton" />
                        <Button x:Name="CloseButton"
                                Content="&#xE8BB;"
                                Style="{StaticResource SettingsCloseCaptionButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close"
                                AutomationProperties.AutomationId="SettingsCloseButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="SettingsContentRoot" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Brush.SurfaceMuted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" />
        <TabControl x:Name="SettingsNavigation"
                    AutomationProperties.AutomationId="SettingsNavigation"
                    Grid.ColumnSpan="2"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
            <TabItem Header="General" Tag="&#xE713;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="General" Style="{StaticResource PageTitleStyle}" />
                    <Border x:Name="GeneralIndexingCard" Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Indexing activity" Style="{StaticResource Text.SectionTitle}" />
                        <!-- Keep the indexing indicator static. WPF's indeterminate ProgressBar animates
                             every frame; inside the transparent, shadowed window that forces expensive
                             full-window recomposition while indexing is active. -->
                        <Border x:Name="IndexingActivityIndicator"
                                Height="5"
                                Margin="0,12,0,10"
                                CornerRadius="2.5"
                                Background="{DynamicResource Brush.Accent}"
                                Visibility="{Binding IsIndexing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding IndexingStatusText}" Style="{StaticResource SettingsDetailStyle}" />
                        <TextBlock Text="{Binding IndexingProgressText}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding CurrentIndexRootText}" Style="{StaticResource SettingsPathTextStyle}" Margin="0,5,0,0" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Software updates" Style="{StaticResource Text.SectionTitle}" />
                        <CheckBox Content="Check GitHub Releases automatically"
                                  IsChecked="{Binding CheckForUpdates}"
                                  Command="{Binding SaveUpdatePreferenceCommand}"
                                  Margin="0,12,0,4" />
                        <TextBlock Text="Changes to this option are saved immediately."
                                   Style="{StaticResource SettingsDetailStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding UpdatePreferenceStatusText}"
                                   Style="{StaticResource SettingsDetailStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource SettingsDetailStyle}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource ActionButtonStyle}" />
                            <Button Content="View release" Command="{Binding OpenReleaseCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                    Visibility="{Binding HasReleaseUrl, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance" AutomationProperties.AutomationId="SettingsAppearanceTab" Tag="&#xE790;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="System follows the Windows app theme. Geek uses a high-contrast terminal palette." Style="{StaticResource SettingsDetailStyle}" Margin="0,6,0,12" />
                        <ComboBox x:Name="ThemeSelector" AutomationProperties.AutomationId="SettingsThemeSelector" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Width="240" HorizontalAlignment="Left" />
                    </StackPanel></Border>
                    <Button x:Name="SaveAppearanceButton" AutomationProperties.AutomationId="SettingsSaveAppearance" Content="Save appearance" Command="{Binding SavePreferencesCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" />
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Hotkeys" Tag="&#xE765;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="Hotkeys" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Click a field, then press the desired key combination." Style="{StaticResource SettingsDetailStyle}" Margin="0,0,0,14" />
                        <TextBlock Text="File search" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="SearchHotkeyBox" AutomationProperties.AutomationId="SettingsSearchHotkey" Text="{Binding SearchHotkeyText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Height="36" Padding="10,6" />
                        <TextBlock Text="Dialog jump" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                        <TextBox x:Name="DialogHotkeyBox" AutomationProperties.AutomationId="SettingsDialogHotkey" Text="{Binding DialogHotkeyText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Height="36" Padding="10,6" />
                        <Button AutomationProperties.AutomationId="SettingsApplyHotkeys" Content="Apply hotkeys" Command="{Binding SaveHotkeysCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding HotkeyStatusText}" Style="{StaticResource SettingsDetailStyle}" Margin="0,8,0,0" />
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="File Search" Tag="&#xE721;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="File Search" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Full-disk indexing" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Check a disk to index the entire disk. An unchecked disk can still contain folders listed below." Style="{StaticResource SettingsDetailStyle}" Margin="0,5,0,6" />
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected}" Margin="0,4" />
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Additional indexed folders (one per line)" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                        <TextBox Text="{Binding IndexedRootsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Windows Start Menu shortcuts are always included as an application source." Style="{StaticResource SettingsDetailStyle}" Margin="0,7,0,0" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Exclusions" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="One full path, folder name, or extension pattern such as *.tmp per line." Style="{StaticResource SettingsDetailStyle}" Margin="0,5,0,10" />
                        <TextBox Text="{Binding ExcludedPathsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Background consistency check" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                        <TextBlock Text="File changes are monitored continuously. This controls only fallback checks for missed changes."
                                   Style="{StaticResource SettingsDetailStyle}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding IndexFrequencyOptions}" SelectedItem="{Binding SelectedIndexFrequency}" Width="240" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingsOptionDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel></Border>
                    <Button Content="Apply and rebuild index" Command="{Binding SavePreferencesCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" />
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Language" Tag="&#xE8C1;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="Display Language" Style="{StaticResource PageTitleStyle}" />
                    <Border x:Name="DisplayLanguageCard" Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="Interface language" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Choose the language used by the ListaryOpen interface. Click Save language to apply it."
                                   Style="{StaticResource SettingsDetailStyle}" Margin="0,6,0,14" TextWrapping="Wrap" />
                        <ComboBox x:Name="UiLanguageSelector"
                                  AutomationProperties.AutomationId="SettingsLanguageSelector"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Width="280" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingsOptionDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel></Border>
                    <Button x:Name="SaveLanguageButton"
                            AutomationProperties.AutomationId="SettingsSaveLanguage"
                            Content="Save language"
                            Command="{Binding SavePreferencesCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SettingsStatusText}"
                               Style="{StaticResource SettingsDetailStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,8,0,0" />
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Actions" Tag="&#xE74C;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="Actions &amp; Integration" Style="{StaticResource PageTitleStyle}" />
                    <Border x:Name="NtfsActionCard" Style="{StaticResource PageCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="NTFS fast indexing" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="{Binding NtfsFastIndexingStatusText}" Style="{StaticResource SettingsDetailStyle}" Margin="0,6,20,0"/></StackPanel>
                        <Border x:Name="NtfsStatusBadge" Grid.Column="1" Tag="{Binding NtfsFastIndexingBadgeKind}" Style="{StaticResource SettingsStatusBadgeStyle}">
                            <TextBlock Text="{Binding NtfsFastIndexingBadgeText}" Style="{StaticResource SettingsStatusBadgeTextStyle}" />
                        </Border>
                        <Button Grid.Column="2" Content="{Binding NtfsFastIndexingActionText}" Command="{Binding EnableNtfsFastIndexingCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                Visibility="{Binding IsNtfsFastIndexingActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid></Border>
                    <Border x:Name="HookActionCard" Style="{StaticResource PageCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Hook Quick Switch" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="{Binding HookQuickSwitchStatusText}" Style="{StaticResource SettingsDetailStyle}" Margin="0,6,20,0"/></StackPanel>
                        <Border x:Name="HookStatusBadge" Grid.Column="1" Tag="{Binding HookQuickSwitchBadgeKind}" Style="{StaticResource SettingsStatusBadgeStyle}">
                            <TextBlock Text="{Binding HookQuickSwitchBadgeText}" Style="{StaticResource SettingsStatusBadgeTextStyle}" />
                        </Border>
                        <Button Grid.Column="2" Content="{Binding HookQuickSwitchActionText}" Command="{Binding EnableHookQuickSwitchCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                Visibility="{Binding IsHookQuickSwitchActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Quick Launch" Tag="&#xE768;" Style="{StaticResource SettingsTabStyle}">
                <Grid Margin="32,28" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Quick Launch" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Grid.Row="1" Text="An enabled rule runs only when the global-search query exactly matches its keyword." Style="{StaticResource SettingsDetailStyle}" Margin="0,0,0,12" />
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="＋" Command="{Binding AddQuickLaunchEntryCommand}" Width="34"/><Button Content="－" Command="{Binding RemoveQuickLaunchEntryCommand}" Width="34" Margin="5,0,0,0"/>
                            <Button Content="↑" Command="{Binding MoveQuickLaunchEntryUpCommand}" Width="34" Margin="12,0,0,0"/><Button Content="↓" Command="{Binding MoveQuickLaunchEntryDownCommand}" Width="34" Margin="5,0,0,0"/>
                        </StackPanel><ListBox ItemsSource="{Binding QuickLaunchEntries}" SelectedItem="{Binding SelectedQuickLaunchEntry}" DisplayMemberPath="Keyword" /></DockPanel>
                        <Border Grid.Column="2" Style="{StaticResource PageCardStyle}"><ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel>
                            <CheckBox Content="Enabled" IsChecked="{Binding SelectedQuickLaunchEntry.Enabled}" />
                            <TextBlock Text="Exact keyword" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedQuickLaunchEntry.Keyword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedQuickLaunchEntry.Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Program or file" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedQuickLaunchEntry.Path, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Arguments" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedQuickLaunchEntry.Arguments, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Working directory" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/><TextBox Text="{Binding SelectedQuickLaunchEntry.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><CheckBox Content="Silent" IsChecked="{Binding SelectedQuickLaunchEntry.Silent}"/><CheckBox Content="Run as administrator" IsChecked="{Binding SelectedQuickLaunchEntry.RunAsAdmin}" Margin="18,0,0,0"/></StackPanel>
                        </StackPanel></ScrollViewer></Border>
                    </Grid>
                    <Button Grid.Row="3" Content="Save quick launch rules" Command="{Binding SavePreferencesCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="Menu" Tag="&#xE700;" Style="{StaticResource SettingsTabStyle}">
                <Grid Margin="32,28" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Explorer Quick Menu" Style="{StaticResource PageTitleStyle}" />
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="＋" Command="{Binding AddMenuEntryCommand}" Width="34"/><Button Content="－" Command="{Binding RemoveMenuEntryCommand}" Width="34" Margin="5,0,0,0"/>
                            <Button Content="↑" Command="{Binding MoveMenuEntryUpCommand}" Width="34" Margin="12,0,0,0"/><Button Content="↓" Command="{Binding MoveMenuEntryDownCommand}" Width="34" Margin="5,0,0,0"/>
                        </StackPanel><ListBox ItemsSource="{Binding MenuEntries}" SelectedItem="{Binding SelectedMenuEntry}" DisplayMemberPath="Title" /></DockPanel>
                        <Border Grid.Column="2" Style="{StaticResource PageCardStyle}"><ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel>
                            <CheckBox Content="Enabled" IsChecked="{Binding SelectedMenuEntry.Enabled}" />
                            <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedMenuEntry.Title, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding MenuActionOptions}" SelectedItem="{Binding SelectedMenuEntry.Action}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingsOptionDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Path or program" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedMenuEntry.Path, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Arguments" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedMenuEntry.Arguments, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Working directory" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><TextBox Text="{Binding SelectedMenuEntry.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox Content="Silent" IsChecked="{Binding SelectedMenuEntry.Silent}" />
                                <CheckBox Content="Run as administrator" IsChecked="{Binding SelectedMenuEntry.RunAsAdmin}" Margin="18,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Supports environment variables and %CURRENT_FOLDER%. Command-only fields apply to RunCommand." Style="{StaticResource SettingsDetailStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel></ScrollViewer></Border>
                    </Grid>
                    <Button Grid.Row="2" Content="Save menu" Command="{Binding SavePreferencesCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="About" Tag="&#xE946;" Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"><StackPanel Style="{StaticResource SettingsPageStackStyle}">
                    <TextBlock Text="About ListaryOpen" Style="{StaticResource PageTitleStyle}" />
                    <Border Style="{StaticResource PageCardStyle}"><StackPanel>
                        <TextBlock Text="ListaryOpen" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Local-first Windows file search and dialog navigation." Style="{StaticResource SettingsDetailStyle}" Margin="0,8,0,18" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Check GitHub Releases" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource ActionButtonStyle}" />
                            <Button Content="View release" Command="{Binding OpenReleaseCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                                    Visibility="{Binding HasReleaseUrl, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatusText}" Margin="0,10,0,0" />
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>

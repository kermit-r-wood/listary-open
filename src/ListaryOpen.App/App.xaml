                    <GeometryDrawing Brush="#2FA876"
                                     Geometry="M 7,7 L 13,7 L 13,21 L 23,21 L 23,26 L 7,26 Z" />
                    <GeometryDrawing Brush="#FFFFFF"
                                     Geometry="M 16,7 L 25,7 L 25,12 L 16,12 Z" />

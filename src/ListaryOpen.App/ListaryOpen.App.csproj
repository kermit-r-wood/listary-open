<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ListaryOpen.Core\ListaryOpen.Core.csproj" />
    <ProjectReference Include="..\ListaryOpen.Infrastructure\ListaryOpen.Infrastructure.csproj" />
    <ProjectReference Include="..\ListaryOpen.Indexer.Elevated\ListaryOpen.Indexer.Elevated.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\ListaryOpen.ico" />
    <Resource Include="Assets\ListaryOpen.ico" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt"
             Link="THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="MsgReader" Version="6.1.0" />
    <PackageReference Include="OpenMcdf" Version="3.1.4" />
    <PackageReference Include="XstReader.Api" Version="1.0.6" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="152.0.7961" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyTitle>ListaryOpen</AssemblyTitle>
    <Product>ListaryOpen</Product>
    <ApplicationIcon>Assets\ListaryOpen.ico</ApplicationIcon>
    <ListaryOpenAppManifest Condition="'$(ListaryOpenAppManifest)' == ''">app.manifest</ListaryOpenAppManifest>
    <ApplicationManifest>$(ListaryOpenAppManifest)</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <BuildNativeHooks Condition="'$(BuildNativeHooks)' == ''">false</BuildNativeHooks>
    <NativeHooksRoot Condition="'$(NativeHooksRoot)' == ''">$(MSBuildProjectDirectory)\..\..\native\ListaryOpen.Hooks</NativeHooksRoot>
    <NativeHooksX64Target Condition="'$(NativeHooksX64Target)' == ''">x86_64-pc-windows-gnullvm</NativeHooksX64Target>
    <NativeHooksX86Target Condition="'$(NativeHooksX86Target)' == ''">i686-pc-windows-gnullvm</NativeHooksX86Target>
    <NativeHooksMingwRoot Condition="'$(NativeHooksMingwRoot)' == '' And '$(SCOOP)' != '' And Exists('$(SCOOP)\apps\mingw-mstorsjo-llvm-msvcrt\current')">$(SCOOP)\apps\mingw-mstorsjo-llvm-msvcrt\current</NativeHooksMingwRoot>
    <NativeHooksMingwRoot Condition="'$(NativeHooksMingwRoot)' == '' And Exists('$(USERPROFILE)\scoop\apps\mingw-mstorsjo-llvm-msvcrt\current')">$(USERPROFILE)\scoop\apps\mingw-mstorsjo-llvm-msvcrt\current</NativeHooksMingwRoot>
    <NativeHooksX64RuntimeDll Condition="'$(NativeHooksX64RuntimeDll)' == '' And '$(NativeHooksMingwRoot)' != ''">$(NativeHooksMingwRoot)\x86_64-w64-mingw32\bin\libunwind.dll</NativeHooksX64RuntimeDll>
    <NativeHooksX86RuntimeDll Condition="'$(NativeHooksX86RuntimeDll)' == '' And '$(NativeHooksMingwRoot)' != ''">$(NativeHooksMingwRoot)\i686-w64-mingw32\bin\libunwind.dll</NativeHooksX86RuntimeDll>
  </PropertyGroup>

  <Target Name="CopyElevatedIndexerBundle" AfterTargets="Build">
    <PropertyGroup>
      <ElevatedIndexerProjectPath>$(MSBuildProjectDirectory)\..\ListaryOpen.Indexer.Elevated\ListaryOpen.Indexer.Elevated.csproj</ElevatedIndexerProjectPath>
      <ElevatedIndexerBuildProperties>Configuration=$(Configuration);TargetFramework=$(TargetFramework)</ElevatedIndexerBuildProperties>
      <ElevatedIndexerBuildProperties Condition="'$(RuntimeIdentifier)' != ''">$(ElevatedIndexerBuildProperties);RuntimeIdentifier=$(RuntimeIdentifier)</ElevatedIndexerBuildProperties>
    </PropertyGroup>
    <MSBuild Projects="$(ElevatedIndexerProjectPath)"
             Targets="GetTargetPath"
             Properties="$(ElevatedIndexerBuildProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="ElevatedIndexerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <ElevatedIndexerBundle Include="%(ElevatedIndexerTargetPath.RootDir)%(ElevatedIndexerTargetPath.Directory)**\*" />
    </ItemGroup>
    <Error Condition="'@(ElevatedIndexerTargetPath)' == ''"
           Text="Could not resolve ListaryOpen.Indexer.Elevated target path." />
    <Error Condition="'@(ElevatedIndexerBundle)' == ''"
           Text="Could not find ListaryOpen.Indexer.Elevated build output to copy." />
    <Copy SourceFiles="@(ElevatedIndexerBundle)"
          DestinationFiles="@(ElevatedIndexerBundle->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyElevatedIndexerBundleToPublishDirectory"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <ElevatedIndexerPublishFiles Include="$(OutDir)ListaryOpen.Indexer.Elevated.*" />
    </ItemGroup>
    <Error Condition="'@(ElevatedIndexerPublishFiles)' == ''"
           Text="Elevated indexer bundle was not found under $(OutDir)." />
    <Copy SourceFiles="@(ElevatedIndexerPublishFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildNativeHooks" AfterTargets="Build" Condition="'$(BuildNativeHooks)' == 'true'">
    <PropertyGroup>
      <NativeHooksX64OutputDir>$(OutDir)hooks\x64\</NativeHooksX64OutputDir>
      <NativeHooksX86OutputDir>$(OutDir)hooks\x86\</NativeHooksX86OutputDir>
      <NativeHooksX64HostSource>$(NativeHooksRoot)\target\$(NativeHooksX64Target)\release\listary_open_hook_host.exe</NativeHooksX64HostSource>
      <NativeHooksX64DllSource>$(NativeHooksRoot)\target\$(NativeHooksX64Target)\release\listary_open_hook.dll</NativeHooksX64DllSource>
      <NativeHooksX86HostSource>$(NativeHooksRoot)\target\$(NativeHooksX86Target)\release\listary_open_hook_host.exe</NativeHooksX86HostSource>
      <NativeHooksX86DllSource>$(NativeHooksRoot)\target\$(NativeHooksX86Target)\release\listary_open_hook.dll</NativeHooksX86DllSource>
      <NativeHooksX64HostDestination>$(OutDir)hooks\x64\ListaryOpen.HookHost.exe</NativeHooksX64HostDestination>
      <NativeHooksX64DllDestination>$(OutDir)hooks\x64\ListaryOpen.Hook.dll</NativeHooksX64DllDestination>
      <NativeHooksX64RuntimeDestination>$(OutDir)hooks\x64\libunwind.dll</NativeHooksX64RuntimeDestination>
      <NativeHooksX86HostDestination>$(OutDir)hooks\x86\ListaryOpen.HookHost.exe</NativeHooksX86HostDestination>
      <NativeHooksX86DllDestination>$(OutDir)hooks\x86\ListaryOpen.Hook.dll</NativeHooksX86DllDestination>
      <NativeHooksX86RuntimeDestination>$(OutDir)hooks\x86\libunwind.dll</NativeHooksX86RuntimeDestination>
    </PropertyGroup>

    <Exec WorkingDirectory="$(NativeHooksRoot)"
          Command="cargo build --release --locked -p listary_open_hook_host -p listary_open_hook --target $(NativeHooksX64Target)" />
    <Exec WorkingDirectory="$(NativeHooksRoot)"
          Command="cargo build --release --locked -p listary_open_hook_host -p listary_open_hook --target $(NativeHooksX86Target)" />

    <Error Condition="!Exists('$(NativeHooksX64HostSource)')"
           Text="Expected native x64 hook host output was not found: $(NativeHooksX64HostSource)" />
    <Error Condition="!Exists('$(NativeHooksX64DllSource)')"
           Text="Expected native x64 hook DLL output was not found: $(NativeHooksX64DllSource)" />
    <Error Condition="'$(NativeHooksX64RuntimeDll)' == ''"
           Text="Could not resolve native x64 libunwind.dll. Set NativeHooksX64RuntimeDll, NativeHooksMingwRoot, SCOOP, or install mingw-mstorsjo-llvm-msvcrt under $(USERPROFILE)\scoop\apps\mingw-mstorsjo-llvm-msvcrt\current." />
    <Error Condition="!Exists('$(NativeHooksX64RuntimeDll)')"
           Text="Expected native x64 libunwind.dll was not found: $(NativeHooksX64RuntimeDll)" />
    <Error Condition="!Exists('$(NativeHooksX86HostSource)')"
           Text="Expected native x86 hook host output was not found: $(NativeHooksX86HostSource)" />
    <Error Condition="!Exists('$(NativeHooksX86DllSource)')"
           Text="Expected native x86 hook DLL output was not found: $(NativeHooksX86DllSource)" />
    <Error Condition="'$(NativeHooksX86RuntimeDll)' == ''"
           Text="Could not resolve native x86 libunwind.dll. Set NativeHooksX86RuntimeDll, NativeHooksMingwRoot, SCOOP, or install mingw-mstorsjo-llvm-msvcrt under $(USERPROFILE)\scoop\apps\mingw-mstorsjo-llvm-msvcrt\current." />
    <Error Condition="!Exists('$(NativeHooksX86RuntimeDll)')"
           Text="Expected native x86 libunwind.dll was not found: $(NativeHooksX86RuntimeDll)" />

    <MakeDir Directories="$(NativeHooksX64OutputDir);$(NativeHooksX86OutputDir)" />
    <Copy SourceFiles="$(NativeHooksX64HostSource)"
          DestinationFiles="$(NativeHooksX64HostDestination)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NativeHooksX64DllSource)"
          DestinationFiles="$(NativeHooksX64DllDestination)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NativeHooksX64RuntimeDll)"
          DestinationFiles="$(NativeHooksX64RuntimeDestination)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NativeHooksX86HostSource)"
          DestinationFiles="$(NativeHooksX86HostDestination)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NativeHooksX86DllSource)"
          DestinationFiles="$(NativeHooksX86DllDestination)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NativeHooksX86RuntimeDll)"
          DestinationFiles="$(NativeHooksX86RuntimeDestination)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeHooksToPublishDirectory"
          AfterTargets="Publish"
          Condition="'$(BuildNativeHooks)' == 'true' And '$(PublishDir)' != ''">
    <ItemGroup>
      <NativeHookPublishFiles Include="$(OutDir)hooks\**\*" />
    </ItemGroup>
    <Error Condition="'@(NativeHookPublishFiles)' == ''"
           Text="Native hook build output was not found under $(OutDir)hooks." />
    <Copy SourceFiles="@(NativeHookPublishFiles)"
          DestinationFiles="@(NativeHookPublishFiles->'$(PublishDir)hooks\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

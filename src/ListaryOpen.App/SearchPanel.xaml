<Window x:Class="ListaryOpen.App.SearchPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ListaryOpen.App.Converters"
        Title="ListaryOpen Search"
        Icon="{StaticResource ListaryOpenIcon}"
        Width="760"
        Height="460"
        MinWidth="620"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource Brush.AppBackground}">
    <Window.Resources>
        <converters:SearchMatchReasonDisplayConverter x:Key="SearchMatchReasonDisplayConverter" />
    </Window.Resources>

    <Grid x:Name="SearchPanelRoot" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource SearchPanelModeTextStyle}"
                       Text="{Binding ModeDisplayText}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Style="{StaticResource SearchStatusTextStyle}"
                       Text="{Binding StatusText}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="QueryBox"
                     AutomationProperties.Name="Search query"
                     Style="{StaticResource SearchQueryBoxStyle}"
                     Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="17,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="18"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="{Binding QueryPlaceholderText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 AutomationProperties.Name="Search results"
                 ItemsSource="{Binding Results}"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 Style="{StaticResource SearchPanelResultListStyle}"
                 ItemContainerStyle="{StaticResource SearchResultItemContainerStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource Brush.SurfaceMuted}"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7C3;" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Record.IsDirectory}" Value="True">
                                                <Setter Property="Text" Value="&#xE8B7;" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SearchResultTitleStyle}"
                                       Text="{Binding Record.Name}" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource SearchResultPathStyle}"
                                       Text="{Binding Record.ParentPath}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTextBlockStyle}">
                                    <Setter Property="MinWidth" Value="56" />
                                    <Setter Property="Text" Value="File" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Record.IsDirectory}" Value="True">
                                            <Setter Property="Text" Value="Folder" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BadgeTextBlockStyle}"
                                   Text="{Binding MatchReason, Converter={StaticResource SearchMatchReasonDisplayConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="SearchStatusText"
                   Grid.Row="3"
                   Margin="2,8,2,0"
                   MinHeight="18"
                   AutomationProperties.Name="Search status"
                   Style="{StaticResource SearchStatusTextStyle}"
                   Text="{Binding StatusText}" />
    </Grid>
</Window>

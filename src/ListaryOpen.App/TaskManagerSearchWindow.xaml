<Window x:Class="ListaryOpen.App.TaskManagerSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ListaryOpen.App"
        Title="Task Manager Search"
        Icon="{StaticResource ListaryOpenIcon}"
        Width="500" Height="360" MinWidth="420" MinHeight="260"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseLeftButtonDown="TaskManagerSearchWindow_PreviewMouseLeftButtonDown"
        Background="{DynamicResource Brush.AppBackground}">
    <Border x:Name="TaskManagerChrome"
            Margin="1" Padding="14" CornerRadius="9"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="2,0,2,10">
                <TextBlock Text="Task Manager" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
            </DockPanel>
            <Grid Grid.Row="1">
                <TextBox x:Name="TaskQueryBox" Height="44" Padding="42,7,12,7"
                         AutomationProperties.AutomationId="TaskManagerSearchQuery"
                         AutomationProperties.Name="Task Manager search query"
                         FontSize="17" VerticalContentAlignment="Center"
                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                           IsHitTestVisible="False" FontFamily="Segoe MDL2 Assets" FontSize="17"
                           Foreground="{DynamicResource Brush.TextMuted}" Text="&#xE721;" />
            </Grid>
            <ListBox x:Name="TaskResults" Grid.Row="2" Margin="0,10,0,8"
                     AutomationProperties.AutomationId="TaskManagerSearchResults"
                     AutomationProperties.Name="Task Manager search results"
                     ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     SelectionChanged="TaskResults_SelectionChanged"
                     MouseLeftButtonUp="TaskResults_MouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SearchResultItemContainerStyle}">
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8"
                              AutomationProperties.AutomationId="{Binding Id}"
                              AutomationProperties.Name="{Binding Name}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource Brush.Accent}" Text="&#xE7C4;" />
                                <Image Width="24" Height="24"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       local:FileIcon.Path="{Binding IconPath}"
                                       local:FileIcon.IsDirectory="False" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="↑/↓ select · Enter confirm · Esc close" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
        </Grid>
    </Border>
</Window>

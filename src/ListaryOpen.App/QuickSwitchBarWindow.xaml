<Window x:Class="ListaryOpen.App.QuickSwitchBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ListaryOpen.App.Converters"
        xmlns:local="clr-namespace:ListaryOpen.App"
        Title="Quick Switch"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        ShowActivated="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:SearchMatchReasonDisplayConverter x:Key="SearchMatchReasonDisplayConverter" />
        <converters:ShortcutIndexConverter x:Key="ShortcutIndexConverter" />
        <converters:SearchResultNameConverter x:Key="SearchResultNameConverter" />
    </Window.Resources>

    <Border x:Name="QuickSwitchChrome"
            Margin="8"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="0,0,9,9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.22"
                              Color="#50000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="&#xE721;" />

                <TextBox x:Name="QuickSwitchQueryBox"
                         Grid.Column="1"
                         Style="{StaticResource OverlaySearchTextBoxStyle}"
                         AutomationProperties.Name="Quick Switch folder search"
                         Margin="4,0,8,0"
                         PreviewMouseLeftButtonDown="QueryBox_PreviewMouseLeftButtonDown"
                         TextChanged="QueryBox_TextChanged"
                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="1"
                           Margin="4,0,8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="15"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Search folders or enter a path…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QuickSwitchQueryBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2"
                           MaxWidth="170"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding QuickSwitchInlineStatus}"
                           Text="{Binding QuickSwitchInlineStatus}" />
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding AreResultsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox x:Name="QuickSwitchResults"
                         AutomationProperties.Name="Quick Switch folder results"
                         AlternationCount="9"
                         MaxHeight="312"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SearchResultItemContainerStyle}"
                         MouseLeftButtonUp="Results_MouseLeftButtonUp"
                         PreviewMouseLeftButtonDown="Results_PreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="Results_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="Results_PreviewMouseRightButtonUp"
                         MouseDoubleClick="Results_MouseDoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu StaysOpen="False"
                                     Opened="ResultsContextMenu_Opened"
                                     Closed="ResultsContextMenu_Closed">
                            <MenuItem Header="Switch to this folder"
                                      Click="OpenResultMenuItem_Click" />
                            <MenuItem Header="Show in File Explorer"
                                      Click="RevealResultMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="Copy full path"
                                      InputGestureText="Ctrl+C"
                                      Click="CopyPathMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="24" Height="24" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Text="&#xE8B7;" />
                                    <Image Width="24"
                                           Height="24"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           local:FileIcon.Path="{Binding Record.FullPath}"
                                           local:FileIcon.IsDirectory="{Binding Record.IsDirectory}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource Font.Primary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Record.FullPath, Converter={StaticResource SearchResultNameConverter}}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Record.ParentPath}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BadgeTextBlockStyle}"
                                           Text="{Binding MatchReason, Converter={StaticResource SearchMatchReasonDisplayConverter}}" />

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource ShortcutIndexConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</Window>

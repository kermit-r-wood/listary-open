<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ListaryOpen.App\ListaryOpen.App.csproj" />
    <ProjectReference Include="..\..\src\ListaryOpen.Infrastructure\ListaryOpen.Infrastructure.csproj" />
    <ProjectReference Include="..\ListaryOpen.DialogPlugin.TestFixture\ListaryOpen.DialogPlugin.TestFixture.csproj" />
    <ProjectReference Include="..\ListaryOpen.TestHost\ListaryOpen.TestHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ListaryOpen.DialogPlugin.TestFixture\dialog-plugin.json"
          Link="plugin-fixture\dialog-plugin.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCompiledDialogPluginFixture" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)ListaryOpen.DialogPlugin.TestFixture.dll"
          DestinationFolder="$(TargetDir)plugin-fixture" />
  </Target>

</Project>

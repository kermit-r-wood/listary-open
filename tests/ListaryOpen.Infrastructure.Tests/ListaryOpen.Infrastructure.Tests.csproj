<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ListaryOpen.Core\ListaryOpen.Core.csproj" />
    <ProjectReference Include="..\..\src\ListaryOpen.App\ListaryOpen.App.csproj" />
    <ProjectReference Include="..\..\src\ListaryOpen.PreviewHost\ListaryOpen.PreviewHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ListaryOpen.Indexer.Elevated\ListaryOpen.Indexer.Elevated.csproj" />
    <ProjectReference Include="..\..\src\ListaryOpen.Infrastructure\ListaryOpen.Infrastructure.csproj" />
    <ProjectReference Include="..\ListaryOpen.DialogPlugin.TestFixture\ListaryOpen.DialogPlugin.TestFixture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ListaryOpen.DialogPlugin.TestFixture\dialog-plugin.json"
          Link="plugin-fixture\dialog-plugin.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCompiledDialogPluginFixture" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)ListaryOpen.DialogPlugin.TestFixture.dll"
          DestinationFolder="$(TargetDir)plugin-fixture" />
  </Target>

</Project>
